---
import Layout from '../../../layouts/Layout.astro';
import CareerHero from '../../../components/CareerHero';
import CareerMisionVision from '../../../components/CareerMisionVision';
import Competencias from '../../../components/Competencias';
import CampoLaboral from '../../../components/CampoLaboral';
import ValoresGrid from '../../../components/ValoresGrid';
import PreinscripcionCta from '../../../components/PreinscripcionCta';
import { careers, type Career } from '../../../data/careers';
import { dictionaries, localizedPath } from '../../../i18n/config';

export function getStaticPaths() {
	return careers.map((career) => ({
		params: { slug: career.slug },
		props: { career },
	}));
}

interface Props {
	career: Career;
}

const { career } = Astro.props;
const locale = 'pt';
const dict = dictionaries[locale];
const content = career[locale];
const careerOptions = careers.map((item) => ({ slug: item.slug, nombre: item[locale].nombre }));
---

<Layout
	locale={locale}
	dict={dict}
	switchHref={localizedPath('es', `/carreras/${career.slug}`)}
	title={`${content.nombre} · Universidad Privada UNO`}
	description={content.resumen}
	ogImage={`/og/${career.slug}.jpg`}
>
	<CareerHero
		nombre={content.nombre}
		resumen={content.resumen}
		image={career.heroImage}
		backHref={`/pt/#carreras`}
		mallaHref={`/pdf/vaucher/${career.slug}.pdf`}
		videoSlug={career.videoSlug}
		t={dict.careerHero}
		videoT={dict.videoModal}
		client:visible
	/>
	<CareerMisionVision mision={content.mision} vision={content.vision} t={dict.careerMisionVision} client:visible />
	{content.competencias && <Competencias grupos={content.competencias} t={dict.competencias} client:visible />}
	<CampoLaboral titulo={content.campoLaboralTitulo} items={content.campoLaboral} t={dict.campoLaboral} client:visible />
	<ValoresGrid valores={content.valores} t={dict.valoresGrid} client:visible />
	<PreinscripcionCta
		titulo={dict.preinscripcion.sectionTitleCareer.replace('{{nombre}}', content.nombre)}
		careers={careerOptions}
		defaultCareer={career.slug}
		t={dict.preinscripcion}
		client:visible
	/>
</Layout>
