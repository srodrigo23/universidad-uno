---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import MisionVision from '../components/MisionVision';
import CareersSection from '../components/CareersSection';
import { careers } from '../data/careers';
import { dictionaries, localizedPath } from '../i18n/config';

const locale = 'es';
const dict = dictionaries[locale];
const careerSummaries = careers.map((career) => ({
	slug: career.slug,
	nombre: career[locale].nombre,
	videoSlug: career.videoSlug,
	image: career.image,
}));
---

<Layout
	locale={locale}
	dict={dict}
	switchHref={localizedPath('pt', '/')}
	title="Universidad Privada UNO · Subsede Cochabamba"
	description="Universidad Privada UNO, Subsede Cochabamba: formación en Enfermería, Medicina, Fisioterapia y Kinesiología, Derecho y Administración de Empresas."
>
	<Hero t={dict.hero} client:visible />
	<MisionVision t={dict.misionVision} client:visible />
	<CareersSection
		careers={careerSummaries}
		basePath="/carreras"
		t={dict.careersSection}
		cardT={dict.careerCard}
		videoT={dict.videoModal}
		client:visible
	/>
</Layout>
