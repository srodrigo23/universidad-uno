---
import Header from '../components/Header';
import Footer from '../components/Footer';
import WhatsAppFloatingButton from '../components/WhatsAppFloatingButton';
import InscripcionesModal from '../components/InscripcionesModal';
import '../styles/global.css';

import Analytics from '@vercel/analytics/astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Universidad Privada UNO · Subsede Cochabamba',
	description = 'Formación universitaria en Enfermería, Medicina, Fisioterapia y Kinesiología, Derecho y Administración de Empresas en Cochabamba, Bolivia.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Poppins:wght@600;800;900&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>

		<Analytics />
	</head>
	<body>
		<Header client:load />
		<slot />
		<Footer client:visible />
		<WhatsAppFloatingButton client:load />
		<InscripcionesModal client:load />
	</body>
</html>
