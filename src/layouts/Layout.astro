---
import Header from '../components/shared/Header';
import Footer from '../components/shared/Footer';
import WhatsAppFloatingButton from '../components/shared/WhatsAppFloatingButton';
import InscripcionesModal from '../components/modals/InscripcionesModal';
import ScrollToTopButton from '../components/shared/ScrollToTopButton';
import '../styles/global.css';

import Analytics from '@vercel/analytics/astro';
import { careers } from '../data/careers';
import type { Locale, Dictionary } from '../i18n/config';

interface Props {
  locale: Locale;
  dict: Dictionary;
  switchHref: string;
  title?: string;
  description?: string;
  /** Ruta pública de la tarjeta social (1200×630). Se generan con `node scripts/generate-og.mjs`. */
  ogImage?: string;
}

const {
  locale,
  dict,
  switchHref,
  title = dict.meta.title,
  description = dict.meta.description,
  ogImage = '/og/default.jpg',
} = Astro.props;
const homeHref = locale === 'es' ? '/' : '/pt/';

// URL canónica absoluta. Se normaliza con barra final para que coincida con las
// rutas que emite el sitemap (build en formato directorio) y evitar que
// /ruta y /ruta/ se indexen como dos páginas distintas.
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
// WhatsApp y Facebook cortan la descripción alrededor de los 200 caracteres;
// los resúmenes de carrera son mucho más largos, así que se recortan por palabra.
const socialDescription =
  description.length > 200
    ? `${description.slice(0, 197).replace(/\s+\S*$/, '')}…`
    : description;
const ogLocale = locale === 'es' ? 'es_BO' : 'pt_BR';
const ogLocaleAlternate = locale === 'es' ? 'pt_BR' : 'es_BO';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isHome = currentPath === '' || currentPath === '/pt';
const careerLinks = careers.map((career) => ({
  slug: career.slug,
  nombre: career[locale].nombre,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />

    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <!-- <link rel="icon" href="/favicon.ico" /> -->

    <link rel='icon' type='image/png' href='/favicon-96x96.png' sizes='96x96' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='shortcut icon' href='/favicon.ico' />
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
    <!-- <meta name="apple-mobile-web-app-title" content="universidad-uno" /> -->
    <link rel='manifest' href='/site.webmanifest' />

    <meta name='generator' content={Astro.generator} />
    <meta name='description' content={description} />
    <link rel='canonical' href={canonical} />

    <!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
    <meta property='og:type' content='website' />
    <meta
      property='og:site_name'
      content='Universidad Privada UNO · Subsede Cochabamba'
    />
    <meta property='og:locale' content={ogLocale} />
    <meta property='og:locale:alternate' content={ogLocaleAlternate} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={socialDescription} />
    <meta property='og:url' content={canonical} />
    <meta property='og:image' content={ogImageUrl} />
    <meta property='og:image:type' content='image/jpeg' />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content={title} />

    <!-- Twitter / X -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={socialDescription} />
    <meta name='twitter:image' content={ogImageUrl} />

    <meta name='theme-color' content='#21366f' />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Poppins:wght@600;800;900&display=swap'
      rel='stylesheet'
    />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      type='text/partytown '
      async
      src='https://www.googletagmanager.com/gtag/js?id=G-W8Y9BQ5NPL'></script>
    <script is:inline type='text/partytown'>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-W8Y9BQ5NPL');
    </script>
    <title>{title}</title>

    <!-- Datos estructurados JSON-LD que aporta cada página. -->
    <slot name='head' />

    <Analytics />
  </head>
  <body>
    {
      /* Lavado ambiental continuo: las secciones son transparentes y se apoyan en él,
		    así no hay bandas alternadas que marquen dónde empieza y termina cada una. */
    }
    <div
      aria-hidden='true'
      class='pointer-events-none fixed inset-0 -z-10 bg-white'
    >
      <div
        class='absolute inset-0'
        style='background-image:
					radial-gradient(70% 55% at 88% 6%, color-mix(in srgb, var(--color-secondary) 9%, transparent) 0%, transparent 62%),
					radial-gradient(62% 50% at 4% 42%, color-mix(in srgb, var(--color-secondary) 7%, transparent) 0%, transparent 62%),
					radial-gradient(85% 55% at 65% 96%, color-mix(in srgb, var(--color-secondary) 7%, transparent) 0%, transparent 66%);'
      >
      </div>
    </div>
    <Header
      client:load
      locale={locale}
      switchHref={switchHref}
      currentPath={Astro.url.pathname}
      careerLinks={careerLinks}
      t={dict.header}
    />
    <slot />
    <Footer client:visible t={dict.footer} />
    <WhatsAppFloatingButton client:load t={dict.whatsapp} />
    {
      isHome && (
        <InscripcionesModal
          client:load
          locale={locale}
          homeHref={homeHref}
          t={dict.inscripcionesModal}
        />
      )
    }
    <ScrollToTopButton client:load t={dict.scrollTop} />
  </body>
</html>
