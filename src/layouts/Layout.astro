---
import Header from '../components/Header';
import Footer from '../components/Footer';
import WhatsAppFloatingButton from '../components/WhatsAppFloatingButton';
import InscripcionesModal from '../components/InscripcionesModal';
import '../styles/global.css';

import Analytics from '@vercel/analytics/astro';
import type { Locale, Dictionary } from '../i18n/config';

interface Props {
	locale: Locale;
	dict: Dictionary;
	switchHref: string;
	title?: string;
	description?: string;
}

const { locale, dict, switchHref, title = dict.meta.title, description = dict.meta.description } = Astro.props;
const homeHref = locale === 'es' ? '/' : '/pt/';
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Poppins:wght@600;800;900&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>

		<Analytics />
	</head>
	<body>
		<Header client:load locale={locale} switchHref={switchHref} t={dict.header} />
		<slot />
		<Footer client:visible t={dict.footer} />
		<WhatsAppFloatingButton client:load t={dict.whatsapp} />
		<InscripcionesModal client:load homeHref={homeHref} t={dict.inscripcionesModal} />
	</body>
</html>
